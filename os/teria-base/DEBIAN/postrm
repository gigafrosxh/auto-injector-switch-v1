#!/bin/sh
set -e
case "$1" in
    remove|purge|abort-install|disappear)
        # Teria-os-release entfernen und Ubuntu-Original zurueckholen
        if dpkg-divert --listpackage /usr/lib/os-release 2>/dev/null | grep -q '^teria-base$'; then
            rm -f /usr/lib/os-release
            dpkg-divert --package teria-base --rename --remove /usr/lib/os-release >/dev/null
        fi
        [ -d /run/systemd/system ] && systemctl daemon-reload || true
        ;;
esac
exit 0
