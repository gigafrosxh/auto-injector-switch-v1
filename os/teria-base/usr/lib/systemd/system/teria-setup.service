[Unit]
Description=Teria: Einrichtung ueber teria-setup.txt auf der SD-Karte
After=local-fs.target teria-firstboot.service
Before=ssh.service ssh.socket NetworkManager.service lightdm.service display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/lib/teria/setup-from-sd

[Install]
WantedBy=multi-user.target
