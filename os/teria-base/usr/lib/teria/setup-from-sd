#!/bin/bash
# Teria Einrichtung ueber die SD-Karte: liest teria-setup.txt von der FAT32-Partition.
#   wlan_name=...  wlan_passwort=...  passwort=...  automatische_anmeldung=ja|nein
# Passwoerter werden nach der Uebernahme aus der Datei entfernt.
set -u
# shellcheck source=os/teria-base/usr/lib/teria/lib.sh
. "${TERIA_LIB:-/usr/lib/teria}/lib.sh"
log() { echo "teria-setup: $*"; }
USER_NAME=teria
account_state=/var/lib/teria/setup-account
if [ -f "$account_state" ]; then
    # Ein fehlgeschlagenes Umbenennen darf WLAN und Passwort von der SD nicht blockieren.
    /usr/lib/teria/setup-account --boot || log "Konto-Umbenennung fehlgeschlagen"
    read -r phase configured_user < "$account_state"
    [ "$phase" != "done" ] || USER_NAME=$configured_user
fi

SD=$(sd_mount) || { log "keine SD-Bootpartition gefunden"; exit 0; }
F="$SD/teria-setup.txt"
if [ ! -f "$F" ]; then
    cat > "$F" <<'TXT'
# Teria-Einrichtung
# Am PC/Mac ausfuellen, speichern, SD zurueck in die Switch und Teria starten.
# Teria uebernimmt die Werte beim naechsten Start und loescht die Passwoerter wieder aus dieser Datei.
wlan_name=
wlan_passwort=
passwort=
automatische_anmeldung=ja
TXT
    log "Vorlage angelegt: teria-setup.txt"
    umount "$SD" 2>/dev/null
    exit 0
fi

val() { sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$F" | tr -d '\r' | sed 's/^\xEF\xBB\xBF//' | tail -n1; }
ssid=$(val wlan_name); psk=$(val wlan_passwort); pw=$(val passwort); auto=$(val automatische_anmeldung)
clear_fields=()
status=0

save_wifi() (
    local safe nm security=
    safe=$(printf '%s' "$ssid" | tr -c 'A-Za-z0-9._-' '_')
    nm=/etc/NetworkManager/system-connections/teria-$safe.nmconnection
    if [ -z "$psk" ] && [ -f "$nm" ]; then
        # Bis 0.3.1 blieb der WLAN-Name nach der Übernahme auf der SD stehen.
        log "Vorhandenes WLAN-Profil beibehalten"
        return 0
    fi
    tmp=$(mktemp "$(dirname "$nm")/.teria-wlan.XXXXXX") || return 1
    trap 'rm -f "$tmp"' EXIT
    if [ -n "$psk" ]; then
        security="[wifi-security]
key-mgmt=wpa-psk
psk=$psk"
    fi
    cat > "$tmp" <<EOF || return 1
[connection]
id=$ssid
type=wifi
autoconnect=true

[wifi]
mode=infrastructure
ssid=$ssid

$security
[ipv4]
method=auto

[ipv6]
method=auto
EOF
    mv -fT "$tmp" "$nm" || return 1
    log "WLAN eingerichtet"
)

if [ -n "$ssid" ]; then
    if save_wifi; then
        clear_fields+=(-e 's/^\([[:space:]]*wlan_name[[:space:]]*=\).*/\1/' -e 's/^\([[:space:]]*wlan_passwort[[:space:]]*=\).*/\1/')
    else
        log "WLAN-Profil konnte nicht gespeichert werden"
        status=1
    fi
fi
if [ -n "$pw" ] && { [ "$pw" = teria ] || [ "$pw" = "$USER_NAME" ]; }; then
    log "Passwort nicht uebernommen: teria oder Benutzername sind nicht erlaubt (SSH bliebe aus)"
    status=1
elif [ -n "$pw" ]; then
    if printf '%s:%s\n' "$USER_NAME" "$pw" | chpasswd && chage -d "$(date +%Y-%m-%d)" "$USER_NAME"; then
        clear_fields+=(-e 's/^\([[:space:]]*passwort[[:space:]]*=\).*/\1/')
        log "Passwort fuer $USER_NAME gesetzt"
    else
        status=1
    fi
fi
case "$auto" in
    ja|Ja|JA|yes|1)
        mkdir -p /etc/lightdm/lightdm.conf.d
        printf '[Seat:*]\nautologin-user=%s\nautologin-user-timeout=0\nautologin-session=teria\n' "$USER_NAME" > /etc/lightdm/lightdm.conf.d/70-teria-autologin.conf
        groupadd -rf autologin; usermod -aG autologin "$USER_NAME" ;;
    nein|Nein|NEIN|no|0)
        rm -f /etc/lightdm/lightdm.conf.d/70-teria-autologin.conf ;;
esac

if [ "${#clear_fields[@]}" -gt 0 ]; then
    sed -i "${clear_fields[@]}" "$F" || status=1
fi
if [ "$status" = 0 ] && [ -n "$pw" ] && [ -f "$account_state" ] && [ "${phase:-}" = pending ]; then
    printf 'done %s\n' "$USER_NAME" > "$account_state"
fi
sync
umount "$SD" 2>/dev/null
exit "$status"
