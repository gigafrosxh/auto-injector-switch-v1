<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Teria</vendor>
  <action id="org.teria.perf">
    <description>Leistungsprofil wechseln</description>
    <message>Leistungsprofil der Switch wechseln</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/teria/perf</annotate>
  </action>
  <action id="org.teria.reboot-hekate">
    <description>In Hekate neu starten</description>
    <message>Die Switch in Hekate neu starten</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/teria/reboot-hekate</annotate>
  </action>
  <action id="org.teria.pkg">
    <description>Software aus dem Teria-Store installieren</description>
    <message>Zum Installieren wird dein Passwort benötigt</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/teria/pkg</annotate>
  </action>
</policyconfig>
